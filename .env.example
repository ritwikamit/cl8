# ============================================
# CL8 Configuration
# ============================================
# Copy this file to .env and fill in your keys
# cp .env.example .env

# --- AI Provider: OpenAI ---
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- AI Provider: Google Gemini ---
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- AI Provider: Ollama (local) ---
# No API key needed. Run: ollama pull codellama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# --- Default Provider ---
# Options: openai, gemini, ollama
CL8_DEFAULT_PROVIDER=openai

# --- Workspace ---
# Default directory for file operations
CL8_WORKSPACE=./workspace

# --- Security ---
# Command approval mode: ask | auto | deny
CL8_APPROVAL_MODE=ask

# --- Logging ---
# Levels: error, warn, info, debug
CL8_LOG_LEVEL=info

# --- Plugins ---
# Comma-separated list of directories to load plugins from
CL8_PLUGIN_DIRS=./plugins
