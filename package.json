{
  "name": "cl8",
  "version": "0.1.0-alpha.16",
  "type": "module",
  "description": "Terminal-first AI coding + automation assistant. Powered by OpenAI, Gemini, or Ollama.",
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "terminal",
    "assistant",
    "openai",
    "gemini",
    "ollama",
    "developer-tools",
    "productivity"
  ],
  "homepage": "https://github.com/ritwikamit/cl8#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritwikamit/cl8.git"
  },
  "bugs": {
    "url": "https://github.com/ritwikamit/cl8/issues"
  },
  "license": "MIT",
  "author": "ritwikamit",
  "main": "dist/index.js",
  "bin": {
    "cl8": "dist/bin/cl8.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "dev": "tsx src/bin/cl8.ts",
    "start": "node dist/bin/cl8.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"console.log('\\n  CL8 installed! Run \\'cl8\\' to start.\\n')\""
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.4.0",
    "commander": "^12.1.0",
    "conf": "^13.1.0",
    "dotenv": "^16.4.7",
    "figlet": "^1.8.0",
    "gradient-string": "^2.0.2",
    "inquirer": "^12.4.0",
    "marked": "^15.0.0",
    "nanoid": "^5.0.9",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "terminal-link": "^3.0.0",
    "undici": "^7.2.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.0"
  }
}
